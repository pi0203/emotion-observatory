      },
      "female": {
        "title": "Female shadow template.svg",
        "url": "https://commons.wikimedia.org/wiki/File:Female_shadow_template.svg"
      }
    },
    "edited": "Only the silhouette, lungs, heart, stomach and intestines were kept. Removed: labels, leader lines, eyes, breast tissue, genitals, brain, bones, vessels, lymph nodes, kidneys and bladder, muscles, the DVT marking."
  },
